{
  "mcpServers": {
    "odoo": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://tester-clouded.odoo.com/mcp",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer ${ODOO_API_KEY}"
      }
    }
  }
}
